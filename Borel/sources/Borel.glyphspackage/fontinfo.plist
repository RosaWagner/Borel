@Base=[@CapsBase e $[name beginswith \"e.\"] $[name beginswith \"eacute\"] $[name beginswith \"ecircumflex\"] $[name beginswith \"edieresis\"] $[name beginswith \"edotbelow\"] $[name beginswith \"egrave\"] $[name beginswith \"ehookabove\"] $[name beginswith \"etilde\"] oe $[name beginswith \"oe.\"] ae $[name beginswith \"ae.\"] c $[name beginswith \"c.\"] l $[name beginswith \"l.\"] $[name beginswith \"ldot\"] $[name beginswith \"ccedilla\"] s $[name beginswith \"s.\"] $[name beginswith \"scedilla\"] $[name beginswith \"germandbls\"] x $[name beginswith \"x.\"]];

