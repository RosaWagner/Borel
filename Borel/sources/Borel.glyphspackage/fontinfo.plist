@CapsBottom=[G Gbreve J Y Yacute Ydotbelow Ygrave Yhookabove Ytilde];
@CapsBase=[L Ldot Z]; 
@Letters=[@Lowercase @CapsMedial @CapsIsol];

# All encoded lowercases letters + idotaccent + t_t
