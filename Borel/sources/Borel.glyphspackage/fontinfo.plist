# Letters that needs connection from the top
@Top=[b $[name beginswith \"b.\"] o $[name beginswith \"o.\"] $[name beginswith \"oacute\"] $[name beginswith \"ocircumflex\"] $[name beginswith \"odieresis\"] $[name beginswith \"odotbelow\"] $[name beginswith \"ograve\"] $[name beginswith \"ohookabove\"] $[name beginswith \"ohorn\"] $[name beginswith \"oslash\"] $[name beginswith \"otilde\"] v $[name beginswith \"v.\"] w $[name beginswith \"w.\"]];

